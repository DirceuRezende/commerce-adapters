{
  "supplierId": "rest-b", "version": 1,
  "operations": {
    "searchCatalog": {
      "route": {"transport": "REST", "connection": "rest-b", "path": "/products", "action": "GET"},
      "requestMapping": {"q": {"path": "$.query", "required": true}},
      "responseMapping": {
        "products": {"path": "$.products[*]", "each": {
          "id": {"path": "$.sku", "required": true},
          "name": {"path": "$.name", "required": true},
          "priceMinor": {"path": "$.price", "transforms": [{"name": "decimalToMinor", "args": {"currency": "BRL"}}]}
        }}
      }
    },
    "createCart": {
      "route": {"transport": "REST", "connection": "rest-b", "path": "/carts", "action": "POST"},
      "requestMapping": {"items": {"path": "$.items[*]", "required": true, "each": {
        "sku": {"path": "$.externalVariantId", "required": true},
        "qty": {"path": "$.quantity", "required": true}
      }}},
      "responseMapping": {
        "externalCartId": {"path": "$.cart_id", "required": true},
        "status": {"path": "$.status", "required": true}
      }
    }
  }
}
