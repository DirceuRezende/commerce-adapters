{
  "supplierId": "hubii", "version": 1,
  "operations": {
    "searchCatalog": {
      "route": {"transport": "UCP_MCP", "connection": "https://q6bgwz-c1.myshopify.com/api/ucp/mcp", "path": "/api/ucp/mcp", "action": "search_catalog"},
      "requestMapping": {
        "query": {"path": "$.query", "required": true},
        "limit": {"path": "$.limit"}
      },
      "responseMapping": {
        "products": {"path": "$.products[*]", "required": true, "each": {
          "id": {"path": "$.id", "required": true},
          "name": {"path": "$.title", "required": true},
          "priceMinor": {"path": "$.price.amount"}
        }}
      }
    },
    "createCart": {
